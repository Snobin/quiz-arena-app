# Copy to deploy/.env (gitignored) and replace every placeholder.
#   cp deploy/.env.example deploy/.env

# local | prod
SPRING_PROFILES_ACTIVE=local

# Caddy. Local: plain HTTP on 8080. Prod: set CADDY_SITE_ADDRESS to the API hostname (automatic TLS and
# HTTP-to-HTTPS redirect), CADDY_HTTP_PORT=80, CADDY_HTTP_TARGET=80, CADDY_HTTPS_BIND=0.0.0.0:443.
CADDY_HTTP_PORT=8080
CADDY_HTTP_TARGET=8080
CADDY_HTTPS_BIND=127.0.0.1:8443
CADDY_SITE_ADDRESS=:8080

# Image tag and registry. Local: "local" (built by `up --build`). Prod: the deploy workflow writes the
# commit SHA here on each deploy.
IMAGE_TAG=local
IMAGE_REGISTRY=ghcr.io/snobin

# Postgres superuser (used only by the container and the init script).
POSTGRES_PASSWORD=change-me-postgres

# Per-service logins; each has rights on its own schema only.
CORE_DB_PASSWORD=change-me-core
RATINGS_DB_PASSWORD=change-me-ratings

# Service-to-service token for core-service /internal/** (game-service sends it). Long and random:
#   openssl rand -hex 32
# Rotate by changing it here and redeploying both services. Unset = every /internal call gets 401.
MINNAL_INTERNAL_TOKEN=change-me-internal-token

# Guest JWT signing key (AD-9): base64 of a PKCS#8 PEM RSA key (>= 2048 bits), on one line:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
# Leave empty locally: core then signs with an ephemeral key (and logs a WARN). Required under prod.
MINNAL_JWT_SIGNING_KEY=
# kid of that key (e.g. 2026-11); empty = the key's RFC 7638 thumbprint.
MINNAL_JWT_KEY_ID=
# Rotation: the previous key's public half, still published in the JWKS until its tokens expire (24 h).
# Comma-separated kid=base64(SPKI PEM) pairs; the public half of a key from MINNAL_JWT_SIGNING_KEY is
#   printf '%s' "$OLD_SIGNING_KEY" | base64 -d | openssl pkey -pubout | base64 | tr -d '\n'
MINNAL_JWT_EXTRA_PUBLIC_KEYS=

# Sign in with Google (Story 2.1). Create an OAuth client (type: Web application) in Google Cloud
# Console > APIs & Services > Credentials, with the callback below as its Authorized redirect URI.
# Never commit real values. Empty = core starts, but /api/core/v1/auth/google/start answers 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of core's callback, on the same registrable domain as the PWA (e.g. minnal.in and
# api.minnal.in) so the refresh cookie is first-party. Locally the Vite proxy makes it the dev origin.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/core/v1/auth/google/callback
# Public URL of the PWA (post sign-in redirect and the only CORS origin allowed to send the cookie).
WEB_URL=http://localhost:5173
# Comma-separated emails that get the ADMIN role when Google reports them verified.
ADMIN_EMAILS=

# Valkey AUTH password.
VALKEY_PASSWORD=change-me-valkey

# prod only: comma-separated allowed browser origins (the Cloudflare Pages origin).
CORS_ALLOWED_ORIGINS=

# prod only: Grafana Cloud free-tier metrics push over OTLP (Story 7.3a). The URL is the OTLP gateway's metrics
# endpoint (https://otlp-gateway-<zone>.grafana.net/otlp/v1/metrics); the value is a full header: Basic base64(<instance id>:<token>).
# Quote any value that contains a space: the backup scripts load this file as shell, so an unquoted `Basic <string>` is cut at the space.
GRAFANA_OTLP_URL=
GRAFANA_OTLP_AUTHORIZATION=""

# Nightly backup and restore drill (Story 7.4a), read by deploy/backup.sh and deploy/restore-drill.sh on the VPS.
# Cloudflare R2 bucket, S3-compatible: https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The uptime monitor's heartbeat URL, called only after a good backup. Set the monitor to alert when it is silent for 26 h.
BACKUP_HEARTBEAT_URL=
