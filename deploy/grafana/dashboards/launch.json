{
  "uid": "minnal-launch",
  "title": "Minnal Launch",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "minnal"
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "7-day return (target 40%)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "minnal_retention_d7_share",
          "legendFormat": "share who came back",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.4
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Cohort: first completed match 8 IST days ago; return = another match on a later IST day within 7 x 24 h. Registered players only."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "7-day cohort size",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "minnal_retention_d7_cohort",
          "legendFormat": "cohort",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Completed matches per session (target 2)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(minnal_session_matches_bucket[1d])))",
          "legendFormat": "median",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(minnal_session_matches_sum[1d])) / sum(rate(minnal_session_matches_count[1d]))",
          "legendFormat": "mean",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "A session starts at a player's first inbound frame after 30 min idle; it starts when she first plays."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Quick Match bot-ended share (target 60% ceiling)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(minnal_match_quick_completed_total{kind=\"bot\"}[1d])) / sum(increase(minnal_match_quick_completed_total[1d]))",
          "legendFormat": "bot-ended share",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.6
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Quick Match queue wait (median)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(minnal_matchmaking_queue_wait_seconds_bucket[1h])))",
          "legendFormat": "median",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Completed vs aborted matches by mode",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (increase(minnal_match_ended_total[1d]))",
          "legendFormat": "completed {{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (mode) (increase(minnal_match_aborted_total[1d]))",
          "legendFormat": "aborted {{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "The only metric where an aborted match appears (FR65)."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Answer confirmation p50 / p95 (200 ms line)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(minnal_match_answer_ack_seconds_bucket[5m])))",
          "legendFormat": "server p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(minnal_match_answer_ack_seconds_bucket[5m])))",
          "legendFormat": "server p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(minnal_match_answer_rtt_milliseconds_bucket[5m]))) / 1000",
          "legendFormat": "client RTT p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(minnal_match_answer_rtt_milliseconds_bucket[5m]))) / 1000",
          "legendFormat": "client RTT p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Scoreboard broadcast latency p95 (500 ms line)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(minnal_match_broadcast_lag_seconds_bucket{kind=\"SCOREBOARD\"}[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Battle Room hosts per IST week (proxy for coaching centres)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "minnal_room_hosts{kind=\"current\"}",
          "legendFormat": "hosts this week",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "minnal_room_hosts_5plus{kind=\"current\"}",
          "legendFormat": "5-plus hosts this week",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "C",
          "expr": "minnal_room_weekly{kind=\"current\"}",
          "legendFormat": "rooms this week",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "D",
          "expr": "minnal_room_hosts{kind=\"previous\"}",
          "legendFormat": "hosts last week",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "PROXY: distinct hosts, and hosts of rooms with 5 or more humans, stand in for coaching centres until the owner defines how a centre is counted. Goal: 5 centres."
    }
  ]
}