{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "minnal",
      "folder": "Minnal",
      "interval": "1m",
      "rules": [
        {
          "uid": "minnal-ack-p95",
          "title": "Answer confirmation p95 over 200 ms",
          "condition": "C",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "annotations": {
            "summary": "Server answer-confirmation p95 has been over 200 ms for 10 minutes."
          },
          "labels": {
            "app": "minnal"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "${PROM_DS_UID}",
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (le) (rate(minnal_match_answer_ack_seconds_bucket[10m])))",
                "instant": true
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.2
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "minnal-nometrics-core",
          "title": "core-service reports no metrics",
          "condition": "C",
          "for": "0m",
          "noDataState": "OK",
          "execErrState": "Error",
          "annotations": {
            "summary": "core-service has sent no metrics for 10 minutes."
          },
          "labels": {
            "app": "minnal"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "${PROM_DS_UID}",
              "model": {
                "refId": "A",
                "expr": "absent_over_time(jvm_memory_used_bytes{service=\"core\"}[10m])",
                "instant": true
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
