        {
          "uid": "minnal-5xx",
          "title": "5xx rate over 2%",
          "condition": "C",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "annotations": {
            "summary": "A service has returned over 2% 5xx for 10 minutes."
          },
          "labels": {
            "app": "minnal"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "${PROM_DS_UID}",
              "model": {
                "refId": "A",
                "expr": "max(sum by (service) (rate(http_server_requests_seconds_count{status=~\"5..\"}[10m])) / sum by (service) (rate(http_server_requests_seconds_count[10m])))",
                "instant": true
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.02
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "minnal-deadletter",
          "title": "Dead-lettered entry",
          "condition": "C",
          "for": "0m",
          "noDataState": "OK",
          "execErrState": "Error",
          "annotations": {
            "summary": "An entry went to a dead-letter stream."
          },
          "labels": {
            "app": "minnal"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "${PROM_DS_UID}",
              "model": {
                "refId": "A",
                "expr": "sum(increase(minnal_stream_deadletter_total[5m]))",
                "instant": true
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "minnal-heap",
          "title": "JVM heap over 90%",
          "condition": "C",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "annotations": {
            "summary": "A service's heap has been over 90% of its cap for 10 minutes."
          },
          "labels": {
            "app": "minnal"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "${PROM_DS_UID}",
              "model": {
                "refId": "A",
                "expr": "max(sum by (service) (jvm_memory_used_bytes{area=\"heap\"}) / sum by (service) (jvm_memory_max_bytes{area=\"heap\"}))",
                "instant": true
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.9
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "contactPoints": [
    {
      "orgId": 1,
      "name": "minnal-developer-email",
      "receivers": [
        {
          "uid": "minnal-email",
          "type": "email",
          "settings": {
            "addresses": "${ALERT_EMAIL}"
          }
        }
      ]
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "minnal-developer-email",
      "group_by": [
        "alertname"
      ],
      "matchers": [
        "app = minnal"
      ]
    }
  ]
}