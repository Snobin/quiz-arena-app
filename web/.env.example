# Copy to .env.local (or set in the build environment). Read at build time by Vite.

# Origin that shared Battle Room links point at: <origin>/r/<code>. No trailing slash.
# Left empty, links use the origin the app is opened from.
VITE_PUBLIC_APP_ORIGIN=

# Origin of core-service's public API. Empty means same origin.
VITE_API_BASE_URL=
